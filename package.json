{
  "name": "loopar-framework",
  "version": "7.0.1",
  "private": true,
  "description": "Loopar — multi-tenant low-code framework. Single-core model: one tenant-less process (the generator) serves every tenant in-process.",
  "license": "MIT",
  "repository": "github:alphabit-technology/loopar-framework",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "loopar": "./bin/cli/index.js"
  },
  "scripts": {
    "preinstall": "node packages/loopar/bin/check-node.js && node bin/setup/installer-clean.js",
    "postinstall": "node bin/setup/ensure-site.js",
    "start": "node bin/tui/index.js",
    "tui": "node bin/tui/index.js",
    "serve": "node bin/cli/index.js serve",
    "prod": "node bin/cli/index.js prod",
    "tenant": "node bin/cli/index.js tenant",
    "migrate": "node bin/cli/index.js migrate",
    "stop": "node bin/cli/index.js stop",
    "restart": "node bin/cli/index.js restart",
    "kill": "node bin/cli/index.js kill",
    "startup": "node bin/cli/index.js startup",
    "logs": "node bin/cli/index.js logs",
    "build": "node bin/build/prepare.js && yarn build:client && yarn build:server && node bin/build/activate.js",
    "build:client": "node bin/build/run-vite.js client",
    "build:server": "node bin/build/run-vite.js server",
    "activate": "node bin/build/activate-staging.js",
    "watch": "node bin/cli/index.js watch",
    "deps": "yarn install --immutable --inline-builds",
    "test": "node --test --test-force-exit \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\""
  }
}
