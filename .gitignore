# -----------------------------------
# 🚀 DEPENDENCIES
# -----------------------------------
node_modules/
packages/*/node_modules/
.pnp/
.pnp.js

# -----------------------------------
# 🛡️  PM2 (Loopar's isolated daemon home, set by bin/pm2-home.js)
# -----------------------------------
.pm2/

# -----------------------------------
# ⚡ PACKAGE MANAGERS
# -----------------------------------
# npm
package-lock.json
npm-debug.log*

# yarn
yarn.lock
.yarn/
.yarnrc.yml
yarn-debug.log*
yarn-error.log*

# pnpm
pnpm-lock.yaml
.pnpm-debug.log*
.pnpm-store/

# -----------------------------------
# 🧪 TESTING
# -----------------------------------
coverage/
# test/ holds the framework's test suite (yarn test); only the manual scripts stay local.
test/test-webhook.js

# -----------------------------------
# 🎨 BUILD OUTPUT
# -----------------------------------
dist
# Anchored to the repo ROOT — bin/build/ is source, only /build/ is output.
/build/

# -----------------------------------
# ⚙️ CONFIGURATION FILES (Auto-generated)
# -----------------------------------
# Anchored to the repo ROOT so it only ignores the runtime /config/core.json
# — NOT source dirs named "config" (e.g. packages/loopar/core/config/).
# Per-tenant config under sites/*/config/ stays covered by the `sites/` rule below.
/config/
tsconfig.tsbuildinfo

# -----------------------------------
# 🔐 ENVIRONMENT VARIABLES
# -----------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# -----------------------------------
# 🖇️ MISCELLANEOUS
# -----------------------------------
.DS_Store
*.pem
stats.html

# -----------------------------------
# 🐞 DEBUG FILES
# -----------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.err
/.*

# -----------------------------------
# 🖥️ IDE CONFIGURATIONS
# -----------------------------------
.idea/
.vscode/

# -----------------------------------
# 🌐 UPLOADS & GENERATED FILES
# -----------------------------------
uploads

# -----------------------------------
# 🌐 SPACES
# -----------------------------------
spaces

# -----------------------------------
# 🧩 APPLICATION FILES
# -----------------------------------
/app/auto
# Apps installed at runtime live in /apps/{name}/ and are user content.
# The core "loopar" app ships with the framework, so we whitelist it.
/apps/*
!/apps/loopar
# Runtime artifacts inside the bundled core app are still ignored.
/apps/loopar/.git/
/apps/loopar/uploads/
/apps/loopar/node_modules/
/path/
.temp

# -----------------------------------
# 🏃 TURBO & CONTENTLAYER
# -----------------------------------
.turbo/
.contentlayer/

# -----------------------------------
# 💡 SUGGESTIONS
# Consider keeping example env/config files:
# .env.example
# config.example.json

# -----------------------------------
# 🧱 DATABASE FILES
# -----------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal

# -----------------------------------
# 🏗️ LOGS & TEMPORARY FILES
# -----------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*

# -----------------------------------
# 🧹 ADDITIONAL NODE/REACT SPECIFICS
# -----------------------------------
.next/
.out/
.cache/
.eslintcache

# -----------------------------------
# 🔥 STORYBOOK FILES (If using Storybook)
# -----------------------------------
out/
.storybook/build/

# -----------------------------------
# 🌍 VITE CACHE
# -----------------------------------
node_modules/.vite

